# SLOTWISE Root Environment Configuration
# Use this template for local docker-compose or containerized production deployment.

# Service Configuration
APP_NAME=SLOTWISE
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Database Configuration (Persistent SQLite volume inside container)
DATABASE_URL=sqlite:////app/data/slotwise.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# Frontend Configuration (Used during Vite build or containerized runtime)
VITE_API_BASE_URL=http://localhost:8000/api
