# Application Settings
APP_NAME=SLOTWISE
ENVIRONMENT=development
LOG_LEVEL=INFO

# API and Server Settings
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# Database Settings (SQLite default, persists to slotwise.db)
DATABASE_URL=sqlite:///./slotwise.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

